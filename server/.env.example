# Copy this file to .env and fill in your real values
# NEVER share your actual .env file with anyone!

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
JWT_SECRET=replace_this_with_a_long_random_string_minimum_32_chars
PORT=4000
CLIENT_URL=https://your-domain.com

# Optional
TRUST_PROXY=2              # proxy hops in front of the app (Render: 1)
DB_POOL_MAX=10
DB_SSL_VERIFY=0            # 1 = verify the DB certificate on non-Neon hosts (production)
LOG_LEVEL=info             # debug | info | warn | error
GOOGLE_SHEET_ID=           # defaults to the production sheet
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY_B64=
BITRIX_WEBHOOK=
